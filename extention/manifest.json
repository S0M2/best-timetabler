{
  "manifest_version": 3,
  "name": "Best Timetabler",
  "version": "1.0.2",
  "description": "Sélection des cours, tri par BAC (1, 2, 3) et couleurs personnalisées pour Portail & Moodle.",
  "browser_specific_settings": {
    "gecko": {
      "id": "best-timetabler@houlock",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "*://portail.henallux.be/*",
    "*://moodle.henallux.be/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*",
    "https://127.0.0.1:8766/*",
    "https://localhost:8766/*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://portail.henallux.be/*",
        "*://moodle.henallux.be/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*"],
      "matches": ["*://portail.henallux.be/*", "*://moodle.henallux.be/*"]
    }
  ]
}